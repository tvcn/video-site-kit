# Never commit real credentials. Local deployment only.

.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
config.local.*

# Generated per-site builds and deploy working copies
/out/
/deploy/
/generator/ai6/site/
/generator/ai6/shots/
__pycache__/

# Separate repo / local-only material（只匹配根目录，避免误伤 generator/ai6/content）
/content/
/.screenshots/

# Local legacy archive (root only)
/archive/

# Local logs and test downloads
*.log
build/downloads/
